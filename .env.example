# 本地开发默认使用内置演示数据，无需密钥即可运行。
VITE_DEMO_MODE=true
VITE_ANALYSIS_API_URL=http://localhost:8787
PORT=8787

# 当前地图底图使用 OpenStreetMap，不需要高德 JS API 密钥。
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=

# 高德“Web 服务”密钥。只放在服务端环境变量，禁止添加 VITE_ 前缀。
AMAP_WEB_SERVICE_KEY=

# 兼容 OpenAI 协议的模型服务。填写实际服务商、接口与模型名称。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 公开网页检索服务。未配置时只能使用地图 POI 与已缓存竞品资料。
SEARCH_API_URL=
SEARCH_API_KEY=
