# 当前版本默认使用内置演示数据，无需密钥即可运行。
VITE_DEMO_MODE=true
VITE_ANALYSIS_API_URL=http://localhost:8787
PORT=8787

# 高德地图 Web 端 JS API。只允许配置在项目中并设置域名白名单。
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=

# 以下只放在服务端 .env.local，禁止添加 VITE_ 前缀。
AMAP_WEB_SERVICE_KEY=

# 兼容 OpenAI 协议的模型服务。填写实际服务商、接口与模型名称。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 公开网页检索服务。未配置时只能使用地图 POI 与已缓存竞品资料。
SEARCH_API_URL=
SEARCH_API_KEY=
